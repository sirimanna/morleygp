---
import Layout from '../../layouts/Layout.astro';
import { getDoctors, getSite, getHours } from '../../lib/content';

export async function getStaticPaths() {
  const doctors = await getDoctors();
  return doctors.map((doctor) => ({
    params: { slug: doctor.slug },
    props: { doctor, doctors },
  }));
}

const { doctor, doctors } = Astro.props;
const site = await getSite();
const hours = await getHours();
const others = doctors.filter((d) => d.slug !== doctor.slug).slice(0, 3);
const firstName = doctor.name.split(' ')[1] ?? doctor.name;
---

<Layout title={`${doctor.name} | Morley General Practice`} description={doctor.bio}>
  <!-- Hero -->
  <div class="pt-40 sm:pt-48 pb-24 sm:pb-28 gradient-bg relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1.5px); background-size: 30px 30px;"></div>
    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full opacity-15" style="background: radial-gradient(circle, #ffffff 0%, transparent 70%)"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
      <nav class="flex items-center gap-2 text-white/60 text-xs font-medium mb-8">
        <a href="/home" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/care-team" class="hover:text-white transition-colors">Our Care Team</a>
        <span>/</span>
        <span class="text-white/90">{doctor.name}</span>
      </nav>
      <div class="flex flex-col sm:flex-row items-center sm:items-end gap-6 sm:gap-10">
        <div class="flex-shrink-0 relative">
          <div class="w-44 h-44 sm:w-56 sm:h-56 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/30" style="background: linear-gradient(160deg, rgba(255,255,255,0.2) 0%, rgba(136,101,169,0.3) 100%)">
            {doctor.photo && <img src={doctor.photo} alt={doctor.name} class="w-full h-full object-cover object-top" />}
          </div>
        </div>
        <div class="text-center sm:text-left pb-2">
          <div class="flex flex-wrap justify-center sm:justify-start gap-2 mb-4">
            {doctor.telehealth && (
              <span class="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-white/15 text-white border border-white/25">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                Telehealth Available
              </span>
            )}
            {doctor.languages && doctor.languages.length > 0 && (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-white/15 text-white border border-white/25"><i class="ri-global-line"></i> {doctor.languages.join(' · ')}</span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-tight mb-2">{doctor.name}</h1>
          <p class="text-white/70 text-base font-medium">{doctor.credentials}</p>
        </div>
      </div>
    </div>
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute bottom-0 left-0 right-0 w-full h-12 sm:h-16 fill-white">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <div class="grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 space-y-10">
        <section>
          <h2 class="text-xl font-black text-gray-900 mb-4">About {doctor.name.split(' ').slice(0, 2).join(' ')}</h2>
          <p class="text-gray-600 leading-relaxed mb-4">{doctor.bio}</p>
          {doctor.detailedBio && <p class="text-gray-600 leading-relaxed">{doctor.detailedBio}</p>}
        </section>

        <section>
          <h2 class="text-xl font-black text-gray-900 mb-5">Areas of Interest</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {doctor.interests.map((interest) => (
              <div class="flex items-center gap-3 gradient-bg-soft border border-blue-100 rounded-xl px-4 py-3">
                <span class="w-6 h-6 rounded-full gradient-bg flex items-center justify-center flex-shrink-0 shadow-sm">
                  <i class="ri-check-line text-white text-xs"></i>
                </span>
                <span class="text-sm font-semibold text-gray-800">{interest}</span>
              </div>
            ))}
          </div>
        </section>

        {doctor.billingNote && (
          <section class="flex items-start gap-4 bg-blue-50 border border-blue-100 rounded-2xl p-6">
            <div class="w-10 h-10 rounded-xl gradient-bg flex items-center justify-center flex-shrink-0 shadow-sm">
              <i class="ri-bank-card-line text-white text-xl"></i>
            </div>
            <div>
              <h4 class="font-bold text-gray-900 mb-1">Billing Information</h4>
              <p class="text-sm text-gray-600 leading-relaxed">{doctor.billingNote}</p>
              <a href="/patient-info" class="text-xs font-semibold text-[#3B6EC9] mt-2 inline-flex items-center gap-1 hover:underline">View full fee schedule <i class="ri-arrow-right-line"></i></a>
            </div>
          </section>
        )}

        <section class="flex items-start gap-4 rounded-2xl p-6" style={`background: ${doctor.telehealth ? 'linear-gradient(135deg, #f0fdf4 0%, #f0ebf8 100%)' : '#f9fafb'}; border: 1px solid ${doctor.telehealth ? '#bbf7d0' : '#e5e7eb'}`}>
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm text-white" style={`background: ${doctor.telehealth ? 'linear-gradient(135deg, #22c55e, #16a34a)' : '#9ca3af'}`}>
            <i class="ri-vidicon-line text-white text-xl"></i>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 mb-1">Telehealth {doctor.telehealth ? 'Available' : 'Not Available'}</h4>
            <p class="text-sm text-gray-600">
              {doctor.telehealth
                ? 'This doctor offers video and phone telehealth consultations for existing patients.'
                : 'This doctor sees patients in-clinic only and does not offer telehealth consultations.'}
            </p>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="gradient-bg rounded-2xl p-7 text-white text-center lg:sticky lg:top-28">
          <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-inner">
            <i class="ri-calendar-check-line text-white text-3xl"></i>
          </div>
          <h3 class="font-black text-lg mb-1">Book with {firstName}</h3>
          <p class="text-white/75 text-xs mb-5 leading-relaxed">Same-day appointments often available. Book online 24/7 through HotDoc.</p>
          {site.hotdocUrl && (
            <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
              class="block bg-white text-[#3B6EC9] py-3.5 rounded-xl font-extrabold text-sm shadow-xl hover:scale-105 transition-all duration-200 mb-3">
              Book Appointment
            </a>
          )}
          <a href={site.phoneHref} class="block bg-white/15 border border-white/25 text-white py-3 rounded-xl font-bold text-sm hover:bg-white/25 transition-all"><i class="ri-phone-line"></i> {site.phone}</a>
        </div>

        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6">
          <h4 class="font-bold text-gray-900 mb-4 text-sm">Clinic Location</h4>
          <div class="space-y-3 text-sm text-gray-600">
            <div class="flex items-start gap-2">
              <i class="ri-map-pin-line text-base mt-0.5"></i>
              <span>{site.address}</span>
            </div>
            <div class="flex items-start gap-2">
              <i class="ri-time-line text-base mt-0.5"></i>
              <span>
                {hours.map((h) => <span class="block">{h.day}: {h.hours}</span>)}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {others.length > 0 && (
      <div class="mt-20">
        <h2 class="text-2xl font-black text-gray-900 mb-8">Meet Our Other Doctors</h2>
        <div class="grid sm:grid-cols-3 gap-5">
          {others.map((doc) => (
            <a href={`/doctor/${doc.slug}`} class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex flex-col">
              <div class="relative h-44 overflow-hidden" style="background: linear-gradient(160deg, #EEF3FC 0%, #F0EBF8 100%)">
                {doc.photo && <img src={doc.photo} alt={doc.name} loading="lazy" class="w-full h-full object-cover object-top" />}
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <h3 class="font-bold text-gray-900 text-base mb-0.5 group-hover:text-[#3B6EC9] transition-colors">{doc.name}</h3>
                <p class="text-xs font-medium text-gray-400 mb-3">{doc.credentials}</p>
                <div class="flex flex-wrap gap-1 mt-auto">
                  {doc.interests.slice(0, 2).map((i) => (
                    <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background: #EEF3FC; color: #3B6EC9">{i}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/care-team" class="gradient-bg text-white px-8 py-3.5 rounded-full font-bold text-sm shadow-lg hover:scale-105 transition-all duration-200 inline-block">View All Doctors</a>
        </div>
      </div>
    )}
  </div>
</Layout>
