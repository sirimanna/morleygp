---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getDoctors, getSite } from '../lib/content';

const doctors = await getDoctors();
const site = await getSite();
---

<Layout
  title="Our Care Team | Morley General Practice"
  description="Meet the experienced, compassionate GPs at Morley General Practice. Male and female doctors with a range of special interests and languages."
>
  <PageHero
    eyebrow="Meet The Team"
    title="Our Care Team"
    subtitle="Experienced, compassionate GPs dedicated to your health and wellbeing, right here in Morley."
  />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20 space-y-8">
    {doctors.map((doctor, idx) => (
      <div class="bg-white border border-gray-100 rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
        <div class="flex flex-col sm:flex-row">
          <div class="flex-shrink-0 flex items-center justify-center sm:items-start p-6 sm:p-8 sm:pb-8 sm:pr-0">
            <div class="relative">
              <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden shadow-lg" style="background: linear-gradient(160deg, #EEF3FC 0%, #F0EBF8 100%)">
                {doctor.photo && <img src={doctor.photo} alt={doctor.name} loading="lazy" class="w-full h-full object-cover object-top" />}
              </div>
              <span class="absolute -bottom-2 -right-2 text-xs font-bold px-2.5 py-1 rounded-full text-white shadow-md" style={`background: ${idx % 2 === 0 ? '#3B6EC9' : '#8865A9'}`}>
                {doctor.credentials.split(',')[0]}
              </span>
            </div>
          </div>

          <div class="flex-1 p-6 sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div>
                <h2 class="text-xl sm:text-2xl font-black text-gray-900 leading-tight">{doctor.name}</h2>
                <p class="text-sm font-medium mt-0.5 text-[#3B6EC9]">{doctor.credentials}</p>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                {doctor.telehealth && (
                  <span class="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-green-50 text-green-700 border border-green-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    Telehealth Available
                  </span>
                )}
                {doctor.languages && doctor.languages.length > 1 && (
                  <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-purple-50 text-purple-700 border border-purple-100">
                    <i class="ri-global-line"></i> {doctor.languages.join(' · ')}
                  </span>
                )}
              </div>
            </div>

            <p class="text-gray-600 text-sm leading-relaxed mb-5">{doctor.bio}</p>

            <div class="mb-5">
              <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Areas of Interest</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4">
                {doctor.interests.map((interest) => (
                  <div class="flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full gradient-bg flex items-center justify-center flex-shrink-0">
                      <i class="ri-check-line text-white text-xs"></i>
                    </span>
                    <span class="text-sm text-gray-700">{interest}</span>
                  </div>
                ))}
              </div>
            </div>

            {doctor.billingNote && (
              <div class="flex items-start gap-2 bg-blue-50 rounded-xl px-4 py-3 mb-6">
                <i class="ri-information-line text-[#3B6EC9] text-base flex-shrink-0 mt-0.5"></i>
                <p class="text-xs text-blue-800 leading-relaxed">{doctor.billingNote}</p>
              </div>
            )}

            <div class="flex flex-wrap gap-3">
              <a href={`/doctor/${doctor.slug}`} class="gradient-bg text-white px-6 py-2.5 rounded-full font-bold text-sm shadow-md hover:shadow-lg hover:scale-105 transition-all duration-200 flex items-center gap-2">
                View Full Profile
                <i class="ri-arrow-right-line"></i>
              </a>
              {site.hotdocUrl && (
                <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
                  class="border-2 px-6 py-2.5 rounded-full font-bold text-sm hover:bg-blue-50 transition-all duration-200 flex items-center gap-2" style="border-color: #3B6EC9; color: #3B6EC9">
                  <i class="ri-calendar-check-line"></i>
                  Book Appointment
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 pb-20">
    <div class="gradient-bg rounded-3xl p-10 sm:p-14 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1.5px); background-size: 30px 30px;"></div>
      <div class="relative z-10">
        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">Book with Your Preferred Doctor</h3>
        <p class="text-white/80 text-base mb-8 max-w-md mx-auto">Select your preferred GP when booking online through HotDoc. Same-day appointments often available.</p>
        {site.hotdocUrl && (
          <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
            class="bg-white text-[#3B6EC9] px-9 py-4 rounded-full font-extrabold shadow-xl hover:scale-105 transition-all duration-200 inline-block">
            Book via HotDoc
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>
