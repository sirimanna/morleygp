---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getSite, getFees } from '../lib/content';

const site = await getSite();
const FEES = await getFees();

const CARDS = [
  { icon: 'ri-bank-card-line', title: 'Mixed Billing Clinic', desc: 'We are a mixed billing clinic. Fees vary based on consultation type, day, and time of your appointment.' },
  { icon: 'ri-parent-line', title: 'Bulk Billing for Children', desc: 'Children under 12 are bulk billed on weekdays between 8:30am and 4:00pm. No out-of-pocket cost.' },
  { icon: 'ri-id-card-line', title: 'Concession & DVA', desc: 'Eligible pensioner/concession card holders and DVA Gold card holders may be bulk billed. Please enquire.' },
];

const FAQS = [
  { q: 'Do you bulk bill?', a: 'We are a mixed billing clinic. Bulk billing is available for children under 12 during weekdays between 8:30am and 4:00pm. Patients aged 65+ with a valid pensioner/concession card or DVA Gold card holders may also be bulk billed. Please enquire when booking.' },
  { q: 'How do I book an appointment?', a: 'You can book online 24/7 via HotDoc, call us on (08) 9275 7755 during opening hours, or visit us in person at 26 McGilvray Ave, Morley WA 6062.' },
  { q: 'Can I get a telehealth appointment?', a: 'Telehealth is available for existing patients. If you are a new patient or have not attended face-to-face within the last 12 months, you will need to attend the clinic in person first. Medicare rebates for telehealth are based on your appointment day and time.' },
  { q: 'What should I bring to my first appointment?', a: 'Please bring a valid photo ID, your Medicare card, any concession/pension/DVA cards, a list of current medications, and any relevant previous test results or specialist letters.' },
  { q: 'Do you charge a cancellation fee?', a: 'We ask that you give us at least 2 hours notice if you need to cancel or reschedule. Repeated no-shows may result in a cancellation fee being applied.' },
  { q: 'Are there fees for after-hours consultations?', a: 'After-hours consultations (Saturday afternoons, Sundays, and Public Holidays) attract higher fees as listed in our fee schedule. In case of emergency, please call 000. Night Doctor (1300 644 483) provides after-hours home visit services.' },
];
---

<Layout
  title="Patient Info & Fees | Morley General Practice"
  description="Billing information, consultation fee schedule, and frequently asked questions for Morley General Practice."
>
  <PageHero
    eyebrow="Important Information"
    title="Patient Info & Fees"
    subtitle="Everything you need to know about appointments, billing, and what to expect at Morley General Practice."
  />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 space-y-16">
    <!-- Billing cards -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-8 text-center">Billing <span class="gradient-text">Overview</span></h2>
      <div class="grid sm:grid-cols-3 gap-5">
        {CARDS.map((item) => (
          <div class="gradient-bg-soft rounded-2xl p-6 text-center">
            <i class={`${item.icon} text-3xl text-[#3B6EC9] inline-block mb-3`}></i>
            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-gray-400 mt-4">No bulk billing is available after 4:30pm weekdays, or on Saturdays, Sundays and Public Holidays for face-to-face or Telehealth appointments.</p>
    </div>

    <!-- Fee table -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-2 text-center">Consultation <span class="gradient-text">Fee Schedule</span></h2>
      <p class="text-center text-sm text-gray-400 mb-8">Fees are reviewed periodically. Please confirm at the time of booking.</p>

      <div class="hidden md:block rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="gradient-bg text-white">
              <th class="text-left px-5 py-4 font-bold">Consultation Type</th>
              <th class="text-left px-5 py-4 font-bold">Day / Time</th>
              <th class="text-right px-5 py-4 font-bold">Fee</th>
              <th class="text-right px-5 py-4 font-bold">Medicare Rebate</th>
              <th class="text-right px-5 py-4 font-bold">Out of Pocket</th>
            </tr>
          </thead>
          <tbody>
            {FEES.map((row, i) => (
              <tr class:list={['border-t border-gray-50', i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50']}>
                <td class="px-5 py-3.5 font-medium text-gray-800">{row.type}</td>
                <td class="px-5 py-3.5 text-gray-500">{row.time}</td>
                <td class="px-5 py-3.5 text-right font-bold text-gray-900">{row.fee}</td>
                <td class="px-5 py-3.5 text-right text-green-600 font-medium">{row.rebate}</td>
                <td class="px-5 py-3.5 text-right font-bold text-[#3B6EC9]">{row.oop}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="md:hidden space-y-3">
        {FEES.map((row) => (
          <div class="border border-gray-100 rounded-xl p-4 bg-white shadow-sm">
            <div class="font-bold text-gray-900 text-sm mb-1">{row.type}</div>
            <div class="text-xs text-gray-400 mb-3">{row.time}</div>
            <div class="grid grid-cols-3 gap-2 text-center">
              <div class="bg-gray-50 rounded-lg p-2"><div class="text-xs text-gray-400 mb-0.5">Fee</div><div class="font-bold text-gray-900 text-sm">{row.fee}</div></div>
              <div class="bg-green-50 rounded-lg p-2"><div class="text-xs text-gray-400 mb-0.5">Rebate</div><div class="font-bold text-green-600 text-sm">{row.rebate}</div></div>
              <div class="rounded-lg p-2" style="background: #EEF3FC"><div class="text-xs text-gray-400 mb-0.5">Out of Pocket</div><div class="font-bold text-sm text-[#3B6EC9]">{row.oop}</div></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Telehealth note -->
    <div class="gradient-bg-soft rounded-2xl p-6 flex gap-4">
      <i class="ri-vidicon-line text-3xl text-[#3B6EC9]"></i>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Telehealth Consultations</h3>
        <p class="text-gray-600 text-sm leading-relaxed">Telehealth fees are the same as face-to-face consultations and are based on your appointment day and time. Medicare rebates are <strong>not available</strong> for Telehealth if you are a new patient or have not attended face-to-face at our clinic within the last 12 months, in accordance with Medicare rules.</p>
      </div>
    </div>

    <!-- After hours -->
    <div class="bg-gray-900 text-white rounded-2xl p-7 flex gap-5 items-start">
      <i class="ri-alarm-warning-line text-3xl mt-1 text-amber-400"></i>
      <div>
        <h3 class="font-bold text-xl mb-2">After Hours & Emergency</h3>
        <p class="text-gray-300 text-sm leading-relaxed mb-3">In case of emergency, call <strong class="text-white">000</strong>. Our centre provides access to medical care for patients 24/7 through after-hours services.</p>
        <p class="text-gray-300 text-sm leading-relaxed">After-hours home visits are provided by <a href="tel:1300644483" class="text-[#8865A9] font-semibold hover:underline">Night Doctors — 1300 644 483</a>. Fee may apply, please enquire at the time of booking.</p>
      </div>
    </div>

    <!-- FAQ -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-8 text-center">Frequently Asked <span class="gradient-text">Questions</span></h2>
      <div class="space-y-3">
        {FAQS.map((faq) => (
          <details class="group border border-gray-100 rounded-2xl overflow-hidden open:border-[#3B6EC9]">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer list-none">
              <span class="font-semibold text-gray-800 text-sm pr-4">{faq.q}</span>
              <i class="ri-arrow-down-s-line text-lg flex-shrink-0 text-[#3B6EC9] transition-transform duration-300 group-open:rotate-180"></i>
            </summary>
            <div class="px-6 pb-5"><p class="text-gray-500 text-sm leading-relaxed">{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      {site.hotdocUrl && (
        <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer" class="gradient-bg text-white px-10 py-4 rounded-full font-extrabold text-base shadow-xl hover:scale-105 transition-all duration-200 inline-block">Book an Appointment</a>
      )}
      <p class="text-gray-400 text-sm mt-3">Or call us on <a href={site.phoneHref} class="text-[#3B6EC9] font-semibold hover:underline">{site.phone}</a></p>
    </div>
  </div>
</Layout>
