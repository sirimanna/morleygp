---
import Layout from '../../layouts/Layout.astro';
import { getServices, getSite } from '../../lib/content';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, services },
  }));
}

const { service, services } = Astro.props;
const site = await getSite();

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const others = services.filter((s) => s.slug !== service.slug).slice(0, 6);
---

<Layout title={`${service.title} | Morley General Practice`} description={service.desc}>
  <!-- Hero -->
  <div class="pt-40 sm:pt-48 pb-24 sm:pb-28 gradient-bg relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1.5px); background-size: 30px 30px;"></div>
    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full opacity-15" style="background: radial-gradient(circle, #ffffff 0%, transparent 70%)"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
      <nav class="flex items-center gap-2 text-white/60 text-xs font-medium mb-8">
        <a href="/home" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span>/</span>
        <span class="text-white/90">{service.title}</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-5 leading-tight max-w-3xl">{service.title}</h1>
      <p class="text-white/80 text-lg sm:text-xl max-w-2xl leading-relaxed mb-8">{service.desc}</p>
      {site.hotdocUrl && (
        <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
          class="inline-block bg-white text-[#3B6EC9] px-9 py-4 rounded-full font-extrabold shadow-2xl hover:scale-105 transition-all duration-200">
          Book an Appointment
        </a>
      )}
    </div>
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute bottom-0 left-0 right-0 w-full h-12 sm:h-16 fill-white">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-10">
        {service.image && (
          <div class="rounded-2xl overflow-hidden shadow-xl h-64 sm:h-80">
            <img src={service.image} alt={service.title} class="w-full h-full object-cover" />
          </div>
        )}

        <section>
          <h2 class="text-2xl font-black text-gray-900 mb-4">About This Service</h2>
          <p class="text-gray-600 leading-relaxed text-base">{service.fullDesc}</p>
        </section>

        <section>
          <h2 class="text-2xl font-black text-gray-900 mb-5">What's Included</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {service.features.map((feature) => (
              <div class="flex items-center gap-3 gradient-bg-soft border border-blue-100 rounded-xl px-4 py-3.5">
                <span class="w-6 h-6 rounded-full gradient-bg flex items-center justify-center flex-shrink-0 shadow-sm">
                  <i class="ri-check-line text-white text-xs"></i>
                </span>
                <span class="text-sm font-semibold text-gray-800">{feature}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="flex items-start gap-4 bg-blue-50 border border-blue-100 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl gradient-bg flex items-center justify-center flex-shrink-0 shadow-sm">
            <i class="ri-information-line text-white text-xl"></i>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 mb-1">Billing Information</h4>
            <p class="text-sm text-gray-600 leading-relaxed">
              We are a mixed billing clinic. Bulk billing is available for children under 12 on weekdays between 8:30am and 4:00pm, and for eligible concession and DVA cardholders. Please enquire when booking.
            </p>
            <a href="/patient-info" class="text-xs font-semibold text-[#3B6EC9] mt-2 inline-flex items-center gap-1 hover:underline">View full fee schedule <i class="ri-arrow-right-line"></i></a>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="gradient-bg rounded-2xl p-7 text-white text-center lg:sticky lg:top-28">
          <h3 class="font-black text-lg mb-1">Book This Service</h3>
          <p class="text-white/75 text-xs mb-5 leading-relaxed">Same-day appointments often available. Book online 24/7.</p>
          {site.hotdocUrl && (
            <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
              class="block bg-white text-[#3B6EC9] py-3.5 rounded-xl font-extrabold text-sm shadow-xl hover:scale-105 transition-all duration-200 mb-3">
              Book via HotDoc
            </a>
          )}
          <a href={site.phoneHref} class="block bg-white/15 border border-white/25 text-white py-3 rounded-xl font-bold text-sm hover:bg-white/25 transition-all">
            <i class="ri-phone-line"></i> {site.phone}
          </a>
        </div>

        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6">
          <h4 class="font-bold text-gray-900 mb-4 text-sm">Other Services</h4>
          <ul class="space-y-2">
            {others.map((s) => (
              <li>
                <a href={`/service/${s.slug}`} class="text-sm text-gray-600 hover:text-[#3B6EC9] flex items-center gap-2 py-1 group transition-colors">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-300 group-hover:bg-[#3B6EC9] transition-colors flex-shrink-0"></span>
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
          <a href="/services" class="mt-4 text-xs font-bold text-[#3B6EC9] hover:underline block">View all services <i class="ri-arrow-right-line"></i></a>
        </div>
      </div>
    </div>

    <!-- Related -->
    <div class="mt-20">
      <h2 class="text-2xl font-black text-gray-900 mb-8">Related Services</h2>
      <div class="grid sm:grid-cols-3 gap-5">
        {related.map((s) => (
          <a href={`/service/${s.slug}`} class="group bg-white border border-gray-100 rounded-2xl p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl gradient-bg flex items-center justify-center mb-4 shadow-sm group-hover:scale-110 transition-transform duration-300">
              <i class="ri-checkbox-circle-line text-white text-2xl"></i>
            </div>
            <h3 class="font-bold text-gray-900 text-base mb-2 group-hover:text-[#3B6EC9] transition-colors">{s.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 gradient-bg rounded-3xl p-10 sm:p-14 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1.5px); background-size: 30px 30px;"></div>
      <div class="relative z-10">
        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">Ready to Book?</h3>
        <p class="text-white/80 text-base mb-8 max-w-md mx-auto">Our friendly team is here to help. Book online in minutes or give us a call.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {site.hotdocUrl && (
            <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
              class="bg-white text-[#3B6EC9] px-9 py-4 rounded-full font-extrabold shadow-xl hover:scale-105 transition-all duration-200">
              Book Now on HotDoc
            </a>
          )}
          <a href="/contact" class="bg-white/15 border border-white/30 text-white px-9 py-4 rounded-full font-bold hover:bg-white/25 transition-all duration-200">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
