---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import QuickInfo from '../components/home/QuickInfo.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import AboutSection from '../components/home/AboutSection.astro';
import TeamSection from '../components/home/TeamSection.astro';
import ReviewsSection from '../components/home/ReviewsSection.astro';
import LocationSection from '../components/home/LocationSection.astro';
import CtaBanner from '../components/home/CtaBanner.astro';
import { getSite } from '../lib/content';

const site = await getSite();

// LocalBusiness / MedicalClinic structured data for SEO.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  telephone: site.phone,
  email: site.email,
  url: 'https://morleygp.com.au',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '26 McGilvray Ave',
    addressLocality: 'Morley',
    addressRegion: 'WA',
    postalCode: '6062',
    addressCountry: 'AU',
  },
  openingHours: ['Mo-Fr 08:30-17:30', 'Sa 08:30-12:30', 'Su 09:00-12:00'],
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <Hero />
  <QuickInfo />
  <ServicesSection />
  <AboutSection />
  <TeamSection />
  <ReviewsSection />
  <LocationSection />
  <CtaBanner />
</Layout>
