---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getSite, getHours } from '../lib/content';

const site = await getSite();
const hours = await getHours();

const cards = [
  { icon: 'ri-map-pin-line', label: 'Address', value: '26 McGilvray Ave', sub: 'Morley WA 6062', href: 'https://maps.google.com/?q=26+McGilvray+Ave+Morley+WA+6062' },
  { icon: 'ri-phone-line', label: 'Phone', value: site.phone, sub: 'Mon–Sun during hours', href: site.phoneHref },
  { icon: 'ri-mail-line', label: 'Email', value: site.email, sub: 'General enquiries', href: `mailto:${site.email}` },
  { icon: 'ri-time-line', label: 'Opening Hours', value: 'Open 7 Days', sub: 'Mon–Fri · Sat · Sun', href: null },
];
---

<Layout
  title="Contact Us | Morley General Practice"
  description="Contact Morley General Practice. Call (08) 9275 7755, email admin@morleygp.com.au, or visit us at 26 McGilvray Ave, Morley WA 6062. Open 7 days."
>
  <PageHero
    eyebrow="We're Here to Help"
    title="Contact Us"
    subtitle="Get in touch with our friendly team, we're open 7 days a week."
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <!-- Info cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
      {cards.map((item) => (
        <div class="gradient-bg-soft rounded-2xl p-6 flex flex-col items-center text-center gap-3">
          <div class="w-12 h-12 gradient-bg rounded-xl text-white flex items-center justify-center shadow-sm text-xl"><i class={item.icon}></i></div>
          <div>
            <div class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">{item.label}</div>
            {item.href
              ? <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="font-bold text-gray-900 text-sm hover:text-[#3B6EC9] transition-colors block">{item.value}</a>
              : <div class="font-bold text-gray-900 text-sm">{item.value}</div>}
            <div class="text-xs text-gray-400 mt-0.5">{item.sub}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Map + form -->
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div class="space-y-6">
        <div class="rounded-3xl overflow-hidden shadow-lg h-72">
          <iframe title="Morley General Practice" src={site.mapEmbed} width="100%" height="100%" style="border: 0; min-height: 288px;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm">
          <h3 class="font-bold text-gray-900 mb-4 text-base">Opening Hours</h3>
          <ul class="space-y-2.5">
            {hours.map((row) => (
              <li class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                <span class="text-sm text-gray-600 font-medium">{row.day}</span>
                <span class:list={['text-sm font-bold px-3 py-1 rounded-full', row.open ? 'text-[#3B6EC9] bg-blue-50' : 'text-gray-400 bg-gray-100']}>{row.hours}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-900 text-white rounded-2xl p-5 flex gap-4 items-start">
          <i class="ri-alarm-warning-line text-2xl mt-0.5 text-amber-400"></i>
          <div>
            <h4 class="font-bold mb-1">After Hours</h4>
            <p class="text-gray-300 text-sm leading-relaxed">In case of emergency call <strong class="text-white">000</strong>. After-hours home visits: <a href="tel:1300644483" class="text-[#8865A9] font-semibold hover:underline">Night Doctors — 1300 644 483</a>.</p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm">
        <div id="contact-success" class="text-center py-12 hidden">
          <div class="w-16 h-16 gradient-bg rounded-full flex items-center justify-center text-white text-3xl mx-auto mb-4 shadow-lg"><i class="ri-check-line"></i></div>
          <h3 class="text-xl font-black text-gray-900 mb-2">Message Sent!</h3>
          <p class="text-gray-500 text-sm">Thanks for reaching out. Our team will get back to you within one business day.</p>
        </div>

        <div id="contact-form-wrap">
          <h3 class="text-xl font-black text-gray-900 mb-1">Send Us a Message</h3>
          <p class="text-gray-400 text-sm mb-6">For urgent matters please call us directly.</p>
          <form id="contact-form" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Full Name *</label>
                <input required name="name" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-[#3B6EC9] focus:ring-2 focus:ring-blue-100 transition-all" placeholder="Jane Smith" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Phone</label>
                <input name="phone" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-[#3B6EC9] focus:ring-2 focus:ring-blue-100 transition-all" placeholder="04xx xxx xxx" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Email *</label>
              <input required type="email" name="email" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-[#3B6EC9] focus:ring-2 focus:ring-blue-100 transition-all" placeholder="jane@example.com" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Message *</label>
              <textarea required rows="5" name="message" class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-[#3B6EC9] focus:ring-2 focus:ring-blue-100 transition-all resize-none" placeholder="How can we help you?"></textarea>
            </div>
            <button type="submit" class="w-full gradient-bg text-white py-3.5 rounded-xl font-bold text-base hover:opacity-90 transition-all duration-200 shadow-md">Send Message</button>
          </form>
          <p class="text-xs text-gray-400 mt-4 text-center">
            Prefer to book an appointment?
            {site.hotdocUrl && <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer" class="text-[#3B6EC9] font-semibold hover:underline">Use HotDoc <i class="ri-arrow-right-line align-middle"></i></a>}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!--
    NOTE: This form shows a success message but does not yet send anywhere.
    Connect a form handler (Formspree, or a Cloudflare Function) at deploy time:
    set the form `action` + `method="POST"` and remove the preventDefault below.
  -->
  <script>
    const form = document.getElementById('contact-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('contact-form-wrap')?.classList.add('hidden');
      document.getElementById('contact-success')?.classList.remove('hidden');
    });
  </script>
</Layout>
