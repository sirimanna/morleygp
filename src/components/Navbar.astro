---
import { NAV_LINKS } from '../data';
import { getSite } from '../lib/content';

const site = await getSite();
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- Utility bar -->
  <div id="utility-bar" class="gradient-bg transition-all duration-300 overflow-hidden max-h-10 py-1.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between">
      <a href={site.phoneHref} class="flex items-center gap-1.5 text-white/90 hover:text-white text-xs font-medium transition-colors">
        <i class="ri-phone-line text-sm"></i>
        {site.phone}
      </a>
      <div class="flex items-center gap-1.5 text-white/90 text-xs font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-green-300 animate-pulse"></span>
        Open 7 Days
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-4 py-3">
      <a href="/home" class="flex-shrink-0">
        <img src={site.logo} alt={site.name} class="h-12 sm:h-14 w-auto object-contain" />
      </a>

      <nav class="hidden lg:flex items-center gap-0">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'relative px-3.5 py-2 text-sm font-semibold transition-colors whitespace-nowrap group',
              isActive(link.href) ? 'text-[#3B6EC9]' : 'text-gray-600 hover:text-[#3B6EC9]',
            ]}
          >
            {link.label}
            <span
              class:list={[
                'absolute bottom-0 left-3.5 right-3.5 h-0.5 rounded-full transition-opacity',
                isActive(link.href) ? 'opacity-100' : 'opacity-0 group-hover:opacity-100',
              ]}
              style="background: linear-gradient(90deg, #3B6EC9, #8865A9)"
            ></span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href={site.phoneHref} class="hidden xl:flex items-center gap-2 text-gray-600 hover:text-[#3B6EC9] transition-colors">
          <div class="w-8 h-8 rounded-full border-2 flex items-center justify-center flex-shrink-0" style="border-color: #3B6EC9">
            <i class="ri-phone-line text-sm text-[#3B6EC9]"></i>
          </div>
          <div>
            <div class="text-xs text-gray-400 leading-none">Call us</div>
            <div class="text-sm font-bold text-gray-700">{site.phone}</div>
          </div>
        </a>
        <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
          class="gradient-bg text-white px-5 sm:px-6 py-2.5 rounded-full text-sm font-bold shadow-md hover:shadow-xl hover:scale-105 transition-all duration-200 whitespace-nowrap">
          Book Now
        </a>
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Toggle menu" aria-expanded="false">
          <i id="menu-open-icon" class="ri-menu-line text-2xl"></i>
          <i id="menu-close-icon" class="ri-close-line text-2xl hidden"></i>
        </button>
      </div>
    </div>
    <div class="h-0.5 w-full" style="background: linear-gradient(90deg, #3B6EC9 0%, #8865A9 100%)"></div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden bg-white border-t border-gray-100 shadow-lg hidden">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
      {NAV_LINKS.map((link) => (
        <a href={link.href}
          class:list={[
            'px-4 py-3 text-sm font-semibold rounded-lg transition-colors',
            isActive(link.href) ? 'text-[#3B6EC9] bg-blue-50' : 'text-gray-700 hover:text-[#3B6EC9] hover:bg-blue-50',
          ]}>
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-3 mt-2 pt-3 border-t border-gray-100">
        <a href={site.phoneHref} class="flex-1 flex items-center justify-center gap-2 border border-gray-200 text-gray-700 py-2.5 rounded-full text-sm font-semibold hover:border-[#3B6EC9] hover:text-[#3B6EC9] transition-colors">
          Call Us
        </a>
        <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
          class="flex-1 gradient-bg text-white text-center py-2.5 rounded-full font-bold text-sm">
          Book Now
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const utilityBar = document.getElementById('utility-bar');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  // Scroll: add shadow, collapse utility bar
  const onScroll = () => {
    const scrolled = window.scrollY > 20;
    header?.classList.toggle('shadow-lg', scrolled);
    if (utilityBar) {
      utilityBar.classList.toggle('max-h-0', scrolled);
      utilityBar.classList.toggle('py-0', scrolled);
      utilityBar.classList.toggle('max-h-10', !scrolled);
      utilityBar.classList.toggle('py-1.5', !scrolled);
    }
  };
  window.addEventListener('scroll', onScroll);
  onScroll();

  // Mobile menu toggle
  menuBtn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
