---
import { getSite, getHours } from '../../lib/content';

const site = await getSite();
const hours = await getHours();

const contact = [
  { label: 'Address', value: site.address, icon: 'ri-map-pin-line' },
  { label: 'Phone', value: site.phone, href: site.phoneHref, icon: 'ri-phone-line' },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'ri-mail-line' },
];
---

<section id="location" class="py-16 sm:py-24 bg-white fade-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="inline-block gradient-text text-sm font-bold uppercase tracking-widest mb-3">Find Us</span>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4">
        Location &amp; <span class="gradient-text">Opening Hours</span>
      </h2>
      <p class="text-gray-500 text-base max-w-xl mx-auto">Conveniently located in Morley, Perth — easy access with ample parking.</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-8 items-stretch">
      <div class="rounded-3xl overflow-hidden shadow-lg h-80 lg:h-auto min-h-[360px]">
        <iframe title="Morley General Practice location" src={site.mapEmbed}
          width="100%" height="100%" style="border: 0; min-height: 360px;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="flex flex-col gap-5">
        <div class="gradient-bg-soft rounded-3xl p-7">
          <h3 class="font-extrabold text-gray-900 text-lg mb-5">Contact &amp; Address</h3>
          <ul class="space-y-4">
            {contact.map((item) => (
              <li class="flex items-start gap-3">
                <span class="w-9 h-9 rounded-xl gradient-bg text-white flex items-center justify-center flex-shrink-0 text-sm"><i class={item.icon}></i></span>
                <div>
                  <div class="text-xs text-gray-400 font-medium uppercase tracking-wide">{item.label}</div>
                  {item.href
                    ? <a href={item.href} class="text-sm font-semibold text-gray-800 hover:text-[#3B6EC9] transition-colors">{item.value}</a>
                    : <div class="text-sm font-semibold text-gray-800">{item.value}</div>}
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white border border-gray-100 rounded-3xl p-7 shadow-sm">
          <h3 class="font-extrabold text-gray-900 text-lg mb-5">Opening Hours</h3>
          <ul class="space-y-3">
            {hours.map((row) => (
              <li class="flex items-center justify-between gap-4 py-2 border-b border-gray-50 last:border-0">
                <span class="text-sm text-gray-600 font-medium">{row.day}</span>
                <span class:list={['text-sm font-bold px-3 py-1 rounded-full', row.open ? 'text-[#3B6EC9] bg-blue-50' : 'text-gray-400 bg-gray-100']}>{row.hours}</span>
              </li>
            ))}
          </ul>
          <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
            class="gradient-bg text-white w-full mt-5 py-3 rounded-full font-bold text-sm text-center block hover:opacity-90 transition-opacity">
            Book an Appointment
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
