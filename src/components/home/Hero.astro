---
import { getSite } from '../../lib/content';

const site = await getSite();

// Split the slogan on the first comma so the second half can be accented.
const [sloganLead, ...sloganRest] = (site.slogan || 'Your Health, Our Priority').split(',');
const sloganAccent = sloganRest.join(',').trim();

const stats = [
  { value: '6+', label: 'Expert GPs' },
  { value: 'Bulk', label: 'Billing Available' },
  { value: '5.0', label: 'Patient Rated', icon: 'ri-star-fill' },
];
const badges = [
  { icon: 'ri-award-line', text: 'Quality Care', color: '#3B6EC9', cls: 'pill-float-a' },
  { icon: 'ri-heart-pulse-line', text: 'Patient First', color: '#8865A9', cls: 'pill-float-b' },
  { icon: 'ri-checkbox-circle-line', text: 'Bulk Billing', color: '#3B6EC9', cls: 'pill-float-c' },
];
---

<section
  id="home"
  class="relative min-h-screen flex items-center pt-28 overflow-hidden"
  style="background: linear-gradient(135deg, #1a3a6e 0%, #3B6EC9 40%, #8865A9 100%)"
>
  <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-20" style="background: radial-gradient(circle, #ffffff 0%, transparent 70%)"></div>
  <div class="absolute bottom-0 -left-24 w-80 h-80 rounded-full opacity-10" style="background: radial-gradient(circle, #8865A9 0%, transparent 70%)"></div>
  <div class="absolute top-1/2 right-1/4 w-64 h-64 rounded-full opacity-10" style="background: radial-gradient(circle, #ffffff 0%, transparent 70%)"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-24 grid lg:grid-cols-2 gap-12 items-center w-full">
    <div class="text-white">
      <h1 class="hero-text hero-text-d1 text-4xl sm:text-5xl lg:text-6xl font-black leading-tight mb-6">
        {sloganLead}{sloganAccent && <>,<br /><span class="text-yellow-300">{sloganAccent}</span></>}
      </h1>
      <p class="hero-text hero-text-d2 text-lg sm:text-xl text-white/85 leading-relaxed mb-8 max-w-lg">
        {site.introduction}
      </p>

      <div class="hero-text hero-text-d3 flex flex-col sm:flex-row items-stretch gap-4">
        <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
          class="bg-white text-[#3B6EC9] rounded-2xl font-extrabold shadow-2xl hover:shadow-white/20 hover:scale-105 transition-all duration-200 flex flex-col items-center justify-center px-10 py-0 h-16">
          <span class="text-lg font-black tracking-wide leading-none">Book Now</span>
          <span class="flex items-center gap-1.5 mt-1.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
            </span>
            <span class="text-xs font-semibold text-green-600 tracking-wide leading-none">Open Now</span>
          </span>
        </a>
        <a href={site.phoneHref}
          class="flex items-center gap-3 bg-white/15 backdrop-blur-sm border border-white/30 text-white px-6 rounded-2xl hover:bg-white/25 transition-all duration-200 h-16">
          <span class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center flex-shrink-0">
            <i class="ri-phone-line text-white text-base"></i>
          </span>
          <div>
            <div class="text-xs text-white/60 font-medium leading-none mb-1">Call us</div>
            <div class="text-base font-bold leading-none">{site.phone}</div>
          </div>
        </a>
      </div>

      <div class="hero-text hero-text-d4 mt-12 grid grid-cols-3 gap-4">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white flex items-center justify-center gap-1">{stat.value}{stat.icon && <i class={`${stat.icon} text-yellow-300`}></i>}</div>
            <div class="text-xs sm:text-sm text-white/70 font-medium mt-0.5">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-img hidden lg:flex justify-center items-center">
      <div class="relative">
        <div class="w-96 h-[480px] rounded-3xl overflow-hidden shadow-2xl">
          <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=800&h=960&fit=crop&auto=format" alt="Friendly doctor in consultation" class="w-full h-full object-cover" />
        </div>
        <div class="absolute -bottom-5 -left-12 bg-white rounded-2xl shadow-2xl p-4 flex items-center gap-3">
          <div class="w-11 h-11 gradient-bg rounded-xl flex items-center justify-center flex-shrink-0">
            <i class="ri-calendar-check-line text-white text-xl"></i>
          </div>
          <div>
            <div class="font-bold text-gray-800 text-sm">Easy Online Booking</div>
            <div class="text-xs text-gray-500">Powered by HotDoc</div>
          </div>
        </div>
        <div class="absolute -top-4 -right-10 flex flex-col gap-3">
          {badges.map((badge) => (
            <div class={`${badge.cls} bg-white/95 backdrop-blur-sm rounded-full shadow-lg px-4 py-2 flex items-center gap-2 text-sm font-bold`} style={`color: ${badge.color}`}>
              <i class={badge.icon}></i>{badge.text}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="w-full h-10 sm:h-16 fill-white">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" />
    </svg>
  </div>
</section>
