---
import { getSite } from '../../lib/content';

const site = await getSite();

const items = [
  { icon: '📍', label: 'Location', value: 'Morley, Perth WA' },
  { icon: '🕐', label: 'Hours', value: 'Open 7 Days a Week' },
  { icon: '📞', label: 'Phone', value: site.phone },
  { icon: '🌐', label: 'Online Booking', value: 'Book via HotDoc' },
];
---

<section class="bg-white py-6 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {items.map((item) => (
        <div class="flex items-center gap-3">
          <span class="text-2xl flex-shrink-0">{item.icon}</span>
          <div>
            <div class="text-xs text-gray-500 font-medium uppercase tracking-wide">{item.label}</div>
            <div class="text-sm font-semibold text-gray-800">{item.value}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
