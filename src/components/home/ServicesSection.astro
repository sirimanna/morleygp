---
import { getServices } from '../../lib/content';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceCard from '../ui/ServiceCard.astro';

// Services are managed in Keystatic (/keystatic -> Services).
const services = await getServices();
const homeServices = services.slice(0, 8);
---

<section id="services" class="py-16 sm:py-24 bg-white fade-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <SectionHeading eyebrow="What We Offer">
      <Fragment slot="title">Comprehensive <span class="gradient-text">Healthcare Services</span></Fragment>
      <Fragment slot="subtitle">From routine check-ups to specialised care, our experienced team is here for every stage of your health journey.</Fragment>
    </SectionHeading>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {homeServices.map((service) => (
        <ServiceCard slug={service.slug} title={service.title} desc={service.desc} />
      ))}
    </div>

    <div class="text-center mt-10">
      <a href="/services" class="gradient-bg text-white px-8 py-3.5 rounded-full font-bold text-base shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200 inline-block">
        View All Services
      </a>
    </div>
  </div>
</section>
