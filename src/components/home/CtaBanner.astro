---
import { getSite } from '../../lib/content';

const site = await getSite();
---

<section class="py-14 sm:py-20 relative overflow-hidden" style="background: linear-gradient(135deg, #3B6EC9 0%, #8865A9 100%)">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1.5px); background-size: 30px 30px;"></div>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center relative z-10">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-5">
      Ready to Take Charge of Your Health?
    </h2>
    <p class="text-white/85 text-lg mb-8 max-w-xl mx-auto">Book your appointment online in minutes with HotDoc. Same-day appointments often available.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
        class="bg-white text-[#3B6EC9] px-10 py-4 rounded-full font-extrabold text-base shadow-2xl hover:scale-105 hover:shadow-white/20 transition-all duration-200">
        Book Now on HotDoc
      </a>
      <a href={site.phoneHref}
        class="bg-transparent border-2 border-white/60 text-white px-10 py-4 rounded-full font-bold text-base hover:bg-white/15 transition-all duration-200">
        Call Us Instead
      </a>
    </div>
  </div>
</section>
