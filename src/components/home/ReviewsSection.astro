---
import { REVIEWS } from '../../data';
import ReviewCard from '../ui/ReviewCard.astro';
---

<section class="py-16 sm:py-24 gradient-bg-soft fade-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="inline-block gradient-text text-sm font-bold uppercase tracking-widest mb-3">Patient Reviews</span>
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4">
        What Our <span class="gradient-text">Patients Say</span>
      </h2>
      <div class="flex items-center justify-center gap-2 mb-2">
        <div class="flex">
          {Array.from({ length: 5 }).map(() => (
            <i class="ri-star-fill text-amber-500 text-xl"></i>
          ))}
        </div>
        <span class="font-bold text-gray-800">4.9 out of 5</span>
        <span class="text-gray-500 text-sm">· 200+ reviews on HotDoc & Google</span>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {REVIEWS.map((review) => (
        <ReviewCard name={review.name} rating={review.rating} text={review.text} date={review.date} />
      ))}
    </div>
  </div>
</section>
