---
import { NAV_LINKS } from '../data';
import { getSite, getHours } from '../lib/content';

const year = new Date().getFullYear();
const site = await getSite();
const hours = await getHours();

const socials = [
  { key: 'facebook', href: site.social.facebook, label: 'Facebook', path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
  { key: 'instagram', href: site.social.instagram, label: 'Instagram', path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm5.5-3a1 1 0 1 0 0 2 1 1 0 0 0 0-2z' },
  { key: 'linkedin', href: site.social.linkedin, label: 'LinkedIn', path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3 0-2.95-1.8-2.95s-2.08 1.4-2.08 2.85V21h-4z' },
  { key: 'youtube', href: site.social.youtube, label: 'YouTube', path: 'M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.4 5.2 12 5.2 12 5.2s-7.4 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.7 1.7c1.5.4 8.9.4 8.9.4s7.4 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12zM10 15.5v-7l6 3.5z' },
].filter((s) => s.href);
---

<footer id="contact" class="bg-gray-900 text-gray-300 pt-14 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div>
        <img src={site.logo} alt={site.name} class="h-14 w-auto object-contain mb-5 brightness-0 invert" />
        <p class="text-sm text-gray-400 leading-relaxed mb-4">
          Providing compassionate, comprehensive healthcare for the Morley community and Perth's northern suburbs.
        </p>
        {socials.length > 0 && (
          <div class="flex gap-3">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
                class="w-9 h-9 rounded-full bg-gray-800 hover:bg-[#3B6EC9] flex items-center justify-center transition-colors">
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-white"><path d={s.path} /></svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h4 class="text-white font-bold mb-4">Quick Links</h4>
        <ul class="space-y-2">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-4">Opening Hours</h4>
        <ul class="space-y-2 text-sm">
          {hours.map((item) => (
            <li class="flex justify-between gap-4">
              <span class="text-gray-400">{item.day}</span>
              <span class="text-white font-medium whitespace-nowrap">{item.hours}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-4">Contact Us</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-3">
            <span class="text-[#8865A9] mt-0.5 flex-shrink-0">📍</span>
            <span class="text-gray-400">{site.address}</span>
          </li>
          <li class="flex gap-3">
            <span class="text-[#8865A9] mt-0.5 flex-shrink-0">📞</span>
            <a href={site.phoneHref} class="text-gray-400 hover:text-white transition-colors">{site.phone}</a>
          </li>
          <li class="flex gap-3">
            <span class="text-[#8865A9] mt-0.5 flex-shrink-0">✉️</span>
            <a href={`mailto:${site.email}`} class="text-gray-400 hover:text-white transition-colors">{site.email}</a>
          </li>
        </ul>
        <div class="flex flex-wrap gap-2 mt-5">
          {site.hotdocUrl && (
            <a href={site.hotdocUrl} target="_blank" rel="noopener noreferrer"
              class="gradient-bg text-white px-6 py-2.5 rounded-full font-bold text-sm inline-block hover:scale-105 transition-transform">
              Book Online →
            </a>
          )}
          {site.healthengineUrl && (
            <a href={site.healthengineUrl} target="_blank" rel="noopener noreferrer"
              class="border border-gray-600 text-gray-200 px-5 py-2.5 rounded-full font-bold text-sm inline-block hover:border-white hover:text-white transition-colors">
              HealthEngine
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/patient-info" class="hover:text-gray-300 transition-colors">Patient Info & Fees</a>
        <a href="/contact" class="hover:text-gray-300 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
