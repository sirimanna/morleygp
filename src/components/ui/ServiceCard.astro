---
interface Props {
  slug: string;
  title: string;
  desc: string;
}
const { slug, title, desc } = Astro.props;
---

<a
  href={`/service/${slug}`}
  class="group relative bg-white border border-gray-100 rounded-2xl p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden block"
>
  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 gradient-bg-soft"></div>
  <div class="relative z-10">
    <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 text-white shadow-md gradient-bg">
      <i class="ri-checkbox-circle-line text-3xl"></i>
    </div>
    <h3 class="font-extrabold text-gray-900 mb-2 text-base">{title}</h3>
    <p class="text-gray-600 text-sm leading-relaxed">{desc}</p>
    <div class="mt-4 flex items-center gap-1 text-[#3B6EC9] text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
      Learn more
      <i class="ri-arrow-right-line"></i>
    </div>
  </div>
</a>
