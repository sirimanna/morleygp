---
interface Props {
  slug: string;
  name: string;
  credentials: string;
  photo: string | null;
  bio: string;
  interests: readonly string[];
}
const { slug, name, credentials, photo, bio, interests } = Astro.props;
const badge = credentials.split(',')[0];
---

<a
  href={`/doctor/${slug}`}
  class="group bg-white border border-gray-100 rounded-3xl overflow-hidden hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex flex-col"
>
  <div
    class="relative flex items-end justify-center overflow-hidden"
    style="background: linear-gradient(160deg, #EEF3FC 0%, #F0EBF8 100%); height: 300px;"
  >
    {photo && <img src={photo} alt={name} loading="lazy" class="h-full w-full object-contain object-bottom" />}
    <div class="absolute top-3 left-3 gradient-bg text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md">
      {badge}
    </div>
  </div>
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-extrabold text-gray-900 text-lg mb-1">{name}</h3>
    <p class="text-gray-500 text-sm leading-relaxed mb-4 flex-1">{bio}</p>
    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-gray-100">
      {interests.slice(0, 4).map((interest) => (
        <span class="text-xs font-semibold px-3 py-1 rounded-full gradient-bg-soft text-[#3B6EC9]">{interest}</span>
      ))}
    </div>
  </div>
</a>
