---
interface Props {
  name: string;
  rating: number;
  text: string;
  date: string;
}
const { name, rating, text, date } = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
---

<div class="bg-white rounded-3xl p-7 shadow-sm hover:shadow-lg transition-shadow duration-300 relative">
  <div class="absolute top-5 right-6 text-6xl font-black leading-none opacity-10 text-[#3B6EC9]">&ldquo;</div>
  <div class="flex gap-0.5">
    {stars.map((filled) => (
      <i class:list={['ri-star-fill text-base', filled ? 'text-[#3B6EC9]' : 'text-gray-200']}></i>
    ))}
  </div>
  <p class="mt-4 text-gray-700 leading-relaxed text-sm mb-6">&ldquo;{text}&rdquo;</p>
  <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
    <div class="w-10 h-10 rounded-full gradient-bg flex items-center justify-center text-white font-bold text-sm flex-shrink-0">{name[0]}</div>
    <div>
      <div class="font-bold text-gray-800 text-sm">{name}</div>
      <div class="text-xs text-gray-400">{date} · Verified Patient</div>
    </div>
  </div>
</div>
