---
interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
---

<div class="text-center mb-12 sm:mb-16">
  <span class="inline-block gradient-text text-sm font-bold uppercase tracking-widest mb-3">{eyebrow}</span>
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 mb-4">
    <slot name="title" />
  </h2>
  <p class="text-gray-600 text-lg max-w-2xl mx-auto">
    <slot name="subtitle" />
  </p>
</div>
